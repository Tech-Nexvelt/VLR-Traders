# Supabase Postgres connection string (this DB is SHARED with Quotation Pro —
# `website` schema is ours, `quotation_pro` is read/written carefully, never migrated).
# Project Settings -> Database -> Connection string -> URI.
# Remember to percent-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:your-password@db.<project-ref>.supabase.co:5432/postgres

# Project Settings -> API
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-only, elevated access (Auth admin API etc.) — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# VLR Interior Solutions' tenant id in quotation_pro.companies.
# Everything admin-auth and the lead-to-customer conversion flow scopes to this.
WEBSITE_COMPANY_ID=
